<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">
	<Script file="RaidBuffStatusSpellIcons.lua"/>
	<Script file="RaidBuffStatus.lua"/>

	<Frame name="RaidBuffStatusFrame" hidden="false" enableMouse="true" movable="true" resizable="true" parent="UIParent" frameStrata="MEDIUM">
		<Size>
			<AbsDimension x="240" y="60"/>
		</Size>
		<Anchors>
			<Anchor point="CENTER">
				<Offset>
					<AbsDimension x="0" y="200"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Backdrop bgFile="Interface\ChatFrame\ChatFrameBackground" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
			<BackgroundInsets>
				<AbsInset left="4" right="4" top="4" bottom="4"/>
			</BackgroundInsets>
			<TileSize val="16"/>
			<EdgeSize val="12"/>
			<Color r="0" g="0" b="0" a="0.75"/>
		</Backdrop>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="RaidBuffStatusFrameTitle" inherits="GameFontNormal" text="RaidBuffStatus">
					<Anchors>
						<Anchor point="TOP" relativePoint="TOP">
							<Offset>
								<AbsDimension x="0" y="-6"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				RBS_OnLoad();
			</OnLoad>
			<OnUpdate>
				RBS_OnUpdate();
			</OnUpdate>
			<OnDragStart>
				this:StartMoving();
			</OnDragStart>
			<OnDragStop>
				this:StopMovingOrSizing();
			</OnDragStop>
			<OnSizeChanged>
				RBS_OnSizeChanged();
			</OnSizeChanged>
			<OnEvent>
				RBS_OnEvent();
			</OnEvent>
		</Scripts>
	</Frame>
</Ui>
